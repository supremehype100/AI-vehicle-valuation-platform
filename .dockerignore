# --- version control / IDE ---
.git
.gitignore
.gitattributes
.vscode
.idea

# --- secrets / env ---
.env
*.env

# --- Facebook scraper stateful/session data — never bake into an image ---
fb_session/
fb_chrome_profile_fresh/

# --- private data — never ship in an image ---
*.csv
graphql_dump/*.json
graphql_dump/*.html

# --- model artifacts / caches — mounted as volumes at runtime instead ---
models/*.pkl
models/**/*.pkl
models/**/*.json
image_cache/
condition_images/

# --- reports / plots generated by evaluation ---
reports/

# --- Python cruft ---
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- OS ---
.DS_Store
Thumbs.db

# --- misc large / irrelevant files sitting in repo root ---
message (2).txt
