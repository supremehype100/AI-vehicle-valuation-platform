# Secrets / env
.env
*.env
.env.*
!.env.example

# Facebook session/profile — runtime dependency, never commit credentials
fb_session/
fb_chrome_profile_fresh/

# Private data — never commit
*.csv
graphql_dump/*.json
graphql_dump/*.html

# Model artifacts — versioned separately via model registry, not git
models/*.pkl
models/**/*.pkl
models/**/*.json
!models/.gitkeep

# Image cache for condition extraction (large binary payloads)
image_cache/
condition_images/

# Reports / plots generated by evaluation
reports/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
