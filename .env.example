# Copy this file to .env and adjust as needed. Every variable is read by
# config.py; the defaults shown match config.py's fallbacks, so an empty or
# missing .env behaves the same as the values below.
#
# When running via docker-compose.yml, the `app`/`db`/`ollama` services set
# DATABASE_URL and OLLAMA_HOST themselves (pointing at the `db`/`ollama`
# service names rather than localhost). The values below are for running the
# project directly on your host.

# --- Database ---------------------------------------------------------------
# SQLAlchemy connection string. Change the password for anything non-local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_intel
POSTGRES_PASSWORD=postgres

# --- Model artifact storage -------------------------------------------------
MODEL_DIR=models
# Defaults to <MODEL_DIR>/registry
# MODEL_REGISTRY_DIR=models/registry

# --- Facebook Marketplace scraper delays ------------------------------------
# Pause (seconds) between checking listings.
FB_LISTING_DELAY_MIN_SECONDS=4.5
FB_LISTING_DELAY_MAX_SECONDS=7.5
# Per-listing page-load wait (ms) before scraping the DOM.
FB_PAGE_LOAD_WAIT_MIN_MS=5000
FB_PAGE_LOAD_WAIT_MAX_MS=7000

# --- Ollama / condition-extraction pipeline ---------------------------------
OLLAMA_HOST=http://localhost:11434
QWEN_MODEL=qwen3-vl:4b-thinking
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_RETRIES=3

# --- Image handling ---------------------------------------------------------
MAX_IMAGES_PER_LISTING=6
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
IMAGE_MAX_DIMENSION_PX=1024
IMAGE_CACHE_DIR=./image_cache

# --- Docker / GPU -----------------------------------------------------------
# Set to false to force CPU-only inference (see docs/GPU_SETUP.md).
OLLAMA_USE_GPU=true
